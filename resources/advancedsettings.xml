<?xml version="1.0" encoding="UTF-8"?>
<!-- Installed on Kodi 19 and 20 only. Kodi 21 moved the <cache> tags to
     Settings > Services > Caching and ignores them here, so it gets
     advancedsettings_kodi21.xml, this file without the <cache> block
     (lib/ui/router.py, _install_advancedsettings). Keep the two
     <network> blocks identical: tests/test_advancedsettings.py checks. -->
<advancedsettings>
    <network>
        <!-- curlclienttimeout is CURLOPT_CONNECTTIMEOUT plus, on some
             handles, CURLOPT_TIMEOUT (xbmc/filesystem/CurlFile.cpp). Kept at
             Kodi's own default: raising it bought nothing against a
             streaming server on 127.0.0.1, where connecting is instant. -->
        <curlclienttimeout>30</curlclienttimeout>
        <!-- THIS is the one that decides how long stopping a stalled stream
             takes. Kodi's playback reader is CFileCache, and its reads are
             governed by CURLOPT_LOW_SPEED_TIME (with LOW_SPEED_LIMIT=1),
             not by curlclienttimeout - so a stream sitting at 0 bytes/s
             waits out this whole window, and CVideoPlayer::CloseFile()
             cannot finish until that thread unblocks.

             Measured on a live stall with curlclienttimeout already lowered
             to 30: stop took 57s, and the curl retry-to-timeout interval was
             exactly 60.000s - i.e. this setting, not the other one. Back to
             Kodi's default of 20, which still rides out a recovering stream
             (the same log shows one recovering across a 16s partial-file
             gap, which a shorter window would have killed) while cutting the
             teardown wait to roughly a third. An add-on cannot interrupt
             Kodi's cache thread, so this timeout IS the only lever. -->
        <curllowspeedtime>20</curllowspeedtime>
        <!-- One retry still absorbs a transient blip - the same log shows
             two partial-file reconnects that recovered mid-playback - while
             halving the worst case versus Kodi's default of 2. -->
        <curlretries>1</curlretries>
    </network>
    <cache>
        <!-- No <buffermode>: Kodi's default (4, network filesystems)
             already caches every http:// stream Rivulet plays, and the
             1 this file used to set also cached local library files. -->
        <!-- Bytes of RAM per playing file: 64 MiB, the default Kodi 21+
             itself ships for filecache.memorysize (system/settings/
             settings.xml), up from Kodi 19/20's 20 MiB. memorysize is the
             cache's whole RAM budget for each cached read, not a budget of
             this add-on, and the boxes this add-on targets (1-2 GB) also
             run the embedded engine, so no larger value is taken without a
             measurement. No <readfactor>: Kodi's default of 4 applies; a
             high factor leaves the reader unthrottled until the cache is
             nearly full (FileCache.cpp), pulling a torrent as fast as the
             engine serves it. -->
        <memorysize>67108864</memorysize>
    </cache>
</advancedsettings>
