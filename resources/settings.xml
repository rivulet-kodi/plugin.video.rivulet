        <category id="server" label="30101">
            <group id="1">
                <!-- server_enable FIRST, server_url after it: a category's
                     first setting is the one Kodi auto-focuses when the
                     dialog opens, and an `edit` control entered that way
                     goes straight into text-input mode - which then eats
                     the arrow keys, so with nothing to arrow to the user
                     is stuck in the field and Back is the only way out.
                     server_url used to be a category of its own (the old
                     "General"), i.e. exactly that dead end. Keep a
                     non-edit control first here, and never give an `edit`
                     setting a category to itself. server_url stays enabled
                     with the embedded server off: it is how an external
                     server is reached. Every other engine setting, here and
                     in the server_* categories, is disabled then: it only
                     reaches the embedded server, as environment variables
                     (lib/service_runner.py EXTRA_ENV_SETTINGS). -->
                <setting id="server_enable" type="boolean" label="30103" help="30591">
                    <level>0</level>
                    <default>true</default>
                    <control type="toggle"/>
                </setting>
                <setting id="server_url" type="string" label="30102" help="30592">
                    <level>0</level>
                    <default>http://127.0.0.1:11470</default>
                    <constraints>
                        <allowempty>false</allowempty>
                    </constraints>
                    <control type="edit" format="string">
                        <heading>30102</heading>
                    </control>
                </setting>
            </group>
            <group id="2" label="30561">
                <setting id="server_binary" type="path" label="30104" help="30593">
                    <level>0</level>
                    <default/>
                    <constraints>
                        <writable>false</writable>
                        <masking>executable</masking>
                        <sources>
                            <source>local</source>
                        </sources>
                        <allowempty>true</allowempty>
                    </constraints>
                    <dependencies>
                        <dependency type="enable" setting="server_enable">true</dependency>
                    </dependencies>
                    <control type="button" format="file">
                        <heading>30104</heading>
                    </control>
                </setting>
                <setting id="server_download" type="action" label="30060" help="30594">
                    <level>0</level>
                    <data>RunPlugin(plugin://plugin.video.rivulet/?action=server_download)</data>
                    <dependencies>
                        <dependency type="enable" setting="server_enable">true</dependency>
                    </dependencies>
                    <control type="button" format="action"/>
                </setting>
                <setting id="server_force_library" type="boolean" label="30362" help="30363">
                    <level>1</level>
                    <default>false</default>
                    <dependencies>
                        <dependency type="enable" setting="server_enable">true</dependency>
                    </dependencies>
                    <control type="toggle"/>
                </setting>
            </group>
        </category>
