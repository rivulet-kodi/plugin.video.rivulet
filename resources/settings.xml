<?xml version="1.0" encoding="UTF-8"?>
<settings version="1">
    <section id="plugin.video.rivulet">
        <category id="home" label="30219">
            <group id="1" label="30555">
                <!-- List arrangements replace the retired row toggles. The
                     one-time migration preserves their choices. Home compares the
                     saved arrangement itself when Settings closes, so this action
                     needs no <close>: a Back that discards the generation bump
                     still shows the new lists. -->
                <setting id="home_lists" type="action" label="30518" help="30519">
                    <level>0</level>
                    <data>RunPlugin(plugin://plugin.video.rivulet/?action=home_lists)</data>
                    <control type="button" format="action"/>
                </setting>
                <setting id="home_show_anime" type="boolean" label="30222" help="30571">
                    <level>0</level>
                    <default>true</default>
                    <control type="toggle"/>
                </setting>
                <setting id="home_hide_adult" type="boolean" label="30280" help="30572">
                    <level>0</level>
                    <default>true</default>
                    <control type="toggle"/>
                </setting>
                <setting id="startup_autoload" type="boolean" label="30230" help="30573">
                    <level>0</level>
                    <default>false</default>
                    <control type="toggle"/>
                </setting>
            </group>
            <group id="2" label="30556">
                <!-- Rotten Tomatoes / Metacritic scores for the hero
                     (lib/stremio/ratings.py). Keys last in their group, and not a
                     category of their own: Kodi focuses a category's first setting,
                     and an edit control traps the arrows. The pair buttons close
                     Settings (saving it) before pairing: while the dialog is open a
                     setSetting() only reaches the dialog's memory, and a Back then
                     discarded the key the phone had just sent. Empty means the hero
                     keeps the catalog's IMDb rating and hides the rest. -->
                <setting id="ratings_pair_omdb" type="action" label="30539" help="30546">
                    <level>0</level>
                    <data>RunPlugin(plugin://plugin.video.rivulet/?action=pair_key&amp;setting=ratings_omdb_key)</data>
                    <control type="button" format="action">
                        <close>true</close>
                    </control>
                </setting>
                <setting id="ratings_omdb_key" type="string" label="30453" help="30515">
                    <level>0</level>
                    <default></default>
                    <constraints>
                        <allowempty>true</allowempty>
                    </constraints>
                    <control type="edit" format="string">
                        <heading>30543</heading>
                        <hidden>true</hidden>
                    </control>
                </setting>
                <setting id="ratings_pair_mdblist" type="action" label="30540" help="30546">
                    <level>0</level>
                    <data>RunPlugin(plugin://plugin.video.rivulet/?action=pair_key&amp;setting=ratings_mdblist_key)</data>
                    <control type="button" format="action">
                        <close>true</close>
                    </control>
                </setting>
                <setting id="ratings_mdblist_key" type="string" label="30454" help="30547">
                    <level>0</level>
                    <default></default>
                    <constraints>
                        <allowempty>true</allowempty>
                    </constraints>
                    <control type="edit" format="string">
                        <heading>30544</heading>
                        <hidden>true</hidden>
                    </control>
                </setting>
            </group>
            <group id="3" label="30557">
                <!-- Clears the catalog, title and ratings caches and the logo
                     answers (lib/ui/cacherefresh.py). Home reloads its rows when
                     Settings closes: cache_generation says so after OK, the
                     deleted cache files after Back (home._drop_memory_if_refreshed).
                     No <close>: it would run the refresh after Home had already
                     looked. -->
                <setting id="refresh_cache" type="action" label="30502" help="30503">
                    <level>0</level>
                    <data>RunPlugin(plugin://plugin.video.rivulet/?action=refresh_cache)</data>
                    <control type="button" format="action"/>
                </setting>
                <setting id="cache_generation" type="string" label="30502">
                    <level>0</level>
                    <visible>false</visible>
                    <default></default>
                    <constraints>
                        <allowempty>true</allowempty>
                    </constraints>
                    <control type="edit" format="string">
                        <heading>30502</heading>
                    </control>
                </setting>
                <setting id="home_layout_generation" type="string" label="30518">
                    <level>0</level>
                    <visible>false</visible>
                    <default></default>
                    <constraints>
                        <allowempty>true</allowempty>
                    </constraints>
                    <control type="edit" format="string">
                        <heading>30518</heading>
                    </control>
                </setting>
            </group>
        </category>
