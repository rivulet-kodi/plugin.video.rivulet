<!-- Season selector. The underline under the selected season spans the
     label's full 190px box, not a narrower rule: Kodi parses <width> once at
     skin load and cannot fit a control to its text, so the only width that is
     right for every label is the box the label itself occupies. It was 120px,
     which is narrower than the text at font13 (NotoSans 30, bold) for most of
     what this bar shows - "Season 2" measures 126px in en_gb and "Temporada 12"
     204px in es_es/pt_br, so the rule stopped short of the word it marks. -->
<control type="list" id="30007">
                <left>80</left><top>300</top><width>1000</width><height>52</height>
                <orientation>horizontal</orientation>
                <onleft>30007</onleft><onright>30007</onright>
                <onup>30030</onup><ondown>30002</ondown>
                <itemlayout width="200" height="52"><control type="label"><left>0</left><top>0</top><width>190</width><height>46</height><font>font13</font><textcolor>8CEDEDED</textcolor><aligny>center</aligny><label>[B]$INFO[ListItem.Label][/B]</label></control></itemlayout>
                <focusedlayout width="200" height="52"><control type="label"><left>0</left><top>0</top><width>190</width><height>46</height><font>font13</font><textcolor>FFEDEDED</textcolor><aligny>center</aligny><label>[B]$INFO[ListItem.Label][/B]</label></control><control type="image"><left>0</left><top>46</top><width>190</width><height>4</height><texture colordiffuse="FFEDEDED">white.png</texture><visible>Control.HasFocus(30007)</visible></control><control type="image"><left>0</left><top>46</top><width>190</width><height>2</height><texture colordiffuse="80EDEDED">white.png</texture><visible>!Control.HasFocus(30007)</visible></control></focusedlayout>
            </control>
