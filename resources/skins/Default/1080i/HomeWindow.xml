<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<window>
    <depth>0.52</depth>
    <coordinates><left>0</left><top>0</top></coordinates>
    <controls>
        <control type="group">
            <left>0</left><top>0</top>
            <visible>!Player.HasVideo</visible>
            <animation type="WindowOpen" reversible="false">
                <effect type="fade" delay="0" end="100" time="200" />
            </animation>
            <animation type="WindowClose" reversible="false">
                <effect type="fade" start="100" end="0" time="160" />
            </animation>
            <control type="image"><width>1920</width><height>1080</height><texture colordiffuse="FF0A0C0E">white.png</texture></control>
            <!-- Backdrop dim. The design (line 40) is filter:brightness(.5),
                 and colordiffuse multiplies, so .5*255 = 0x80. This was
                 FF3A3A3A (0.23) inherited from the pre-1a skin, sitting under
                 a CC000000 80% black sheet that 1a does not have at all -
                 together they rendered the fanart 2.1x darker than the
                 reference. Kodi cannot do the design's saturate(.8); the
                 multiply is the whole effect. -->
            <control type="image" id="30000"><width>1920</width><height>1080</height><texture colordiffuse="FF808080"></texture><aspectratio>scale</aspectratio></control>
            <!-- Left-to-right legibility scrim. Design line 41: solid to 44%
                 of the width, .86 opacity at 62% (x=1190), .62 at the right
                 edge. fade_h.png bakes exactly those stops (alpha 255 -> 219
                 -> 158). A solid
                 FF0A0C0E panel covers the menu column to x=845, then a single
                 fade_h.png ramp carries the falloff across the remaining
                 1075px. fade_h.png is white with a baked alpha ramp, so
                 colordiffuse tints it to the panel's exact colour and the join
                 is continuous. Neither white.png bands nor fade_edge.png work
                 here: stacked bands leave visible steps at their edges (seams
                 were measured at x=880 and x=975 on a real capture), and
                 fade_edge.png's own pixels are pure black, so tinting can only
                 scale its alpha, never reproduce FF0A0C0E. -->
            <control type="image"><width>845</width><height>1080</height><texture colordiffuse="FF0A0C0E">white.png</texture></control>
            <control type="image"><left>845</left><width>1075</width><height>1080</height><texture colordiffuse="FF0A0C0E">fade_h.png</texture></control>
            <control type="image"><left>120</left><top>96</top><width>64</width><height>64</height><texture>logo.png</texture><aspectratio>keep</aspectratio></control>
            <control type="label"><left>204</left><top>96</top><width>400</width><height>64</height><font>font32</font><textcolor>FFEEF3F6</textcolor><aligny>center</aligny><label>[B]RIVULET[/B]</label></control>
            <!-- No plate behind the status line. 1AFFFFFF is the skin's
                 hairline colour - every other use of it (BusyDialog,
                 ConfirmDialog, OptionListDialog, CountdownDialog,
                 ProgressDialog, ShowcaseWindow, StreamsWindow) is a 1px
                 rule, and a 720x48 fill of it was the one place the skin
                 used it as a plate. The status is carried by the label's
                 own `[COLOR]`-tinted dot (see `_status_text()`): accent
                 blue when logged in, dim when not. The backdrop here is
                 the addon's own bundled fanart.jpg, never per-title art,
                 so the text has a known dark field behind it and needs
                 no plate of its own for legibility. -->
            <control type="label" id="30005">
                <left>1100</left><top>104</top><width>680</width><height>48</height><font>font10</font><textcolor>A8EEF3F6</textcolor><align>right</align><aligny>center</aligny>
                <label></label>
            </control>
            <!-- 82px rows, sized for NINE of them now that Continue
                 watching is a conditional 9th row above Movies. 9x82 = 738:
                 the list starts at 200 (40 clear of the RIVULET wordmark,
                 which ends at 160) and ends at 938, with the hint strip at
                 1000 keeping 62px clear.
                 History: 0.9.1 used 120px rows. That became 92px sized for
                 EIGHT rows (movies/series/anime/other/search/library/
                 addons/settings; at 120 that would need 960px and run off a
                 1080 screen). It was 7x92 = 644 at top=248 until the
                 `other` row arrived and pushed Settings out of view - the
                 list scrolled, so Settings stayed reachable, but nothing on
                 screen said so. Continue watching's 9th row then pushed
                 8x92=736 to 9x82=738; internals keep the same proportions,
                 re-centred for the shorter row - 52px icon at top=15, and
                 the 68px title+subtitle block at top=7. -->
            <control type="list" id="30002">
                <left>120</left><top>200</top><width>900</width><height>738</height>
                <onleft>30002</onleft><onright>30002</onright>
                <itemlayout height="82">
                    <control type="image"><left>34</left><top>15</top><width>52</width><height>52</height><texture colordiffuse="80FFFFFF">$INFO[ListItem.Icon]</texture><aspectratio>keep</aspectratio></control>
                    <control type="label"><left>118</left><top>7</top><width>750</width><height>36</height><font>font32</font><textcolor>C7EEF3F6</textcolor><aligny>center</aligny>
                        <label>$INFO[ListItem.Label]</label>
                    </control>
                    <control type="label"><left>118</left><top>47</top><width>750</width><height>28</height><font>font12</font><textcolor>6BEEF3F6</textcolor><aligny>center</aligny>
                        <label>$INFO[ListItem.Property(subtitle)]</label>
                    </control>
                </itemlayout>
                <focusedlayout height="82">
                    <control type="image"><width>900</width><height>82</height><texture colordiffuse="FF1B2126">white.png</texture></control>
                    <control type="image"><left>0</left><width>6</width><height>82</height><texture colordiffuse="FF38BDF8">white.png</texture></control>
                    <control type="image"><left>34</left><top>15</top><width>52</width><height>52</height><texture>$INFO[ListItem.Icon]</texture><aspectratio>keep</aspectratio></control>
                    <control type="label"><left>118</left><top>7</top><width>750</width><height>36</height><font>font32</font><textcolor>FFFFFFFF</textcolor><aligny>center</aligny>
                        <label>[B]$INFO[ListItem.Label][/B]</label>
                    </control>
                    <control type="label"><left>118</left><top>47</top><width>750</width><height>28</height><font>font12</font><textcolor>B3EEF3F6</textcolor><aligny>center</aligny>
                        <label>$INFO[ListItem.Property(subtitle)]</label>
                    </control>
                </focusedlayout>
            </control>
            <control type="label"><left>120</left><top>1000</top><width>600</width><height>32</height><font>Mono26</font><textcolor>57EEF3F6</textcolor><aligny>center</aligny>
                <label>[COLOR FF38BDF8]OK[/COLOR] $ADDON[plugin.video.rivulet 30209]     [COLOR FF38BDF8]BACK[/COLOR] $ADDON[plugin.video.rivulet 30211]</label>
            </control>
        </control>
    </controls>
</window>
