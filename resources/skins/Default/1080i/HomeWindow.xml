<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<window>
    <depth>0.52</depth>
    <coordinates><left>0</left><top>0</top></coordinates>
    <controls>
        <control type="group">
            <left>0</left><top>0</top>
            <visible>!Player.HasVideo</visible>
            <animation type="WindowOpen" reversible="false">
                <effect type="fade" delay="0" end="100" time="200" />
            </animation>
            <animation type="WindowClose" reversible="false">
                <effect type="fade" start="100" end="0" time="160" />
            </animation>
            <control type="image"><width>1920</width><height>1080</height><texture colordiffuse="FF141414">white.png</texture></control>
            <control type="image" id="30000"><width>1920</width><height>1080</height><texture colordiffuse="FF3A3A3A"></texture><aspectratio>scale</aspectratio></control>
            <control type="image"><width>1920</width><height>1080</height><texture colordiffuse="CC000000">white.png</texture></control>
            <!-- Left-to-right legibility scrim (design: solid to 44% of the
                 width, 62% opacity at x=1190, 38% at the right edge). A solid
                 FF0A0C0E panel covers the menu column to x=845, then a single
                 fade_h.png ramp carries the falloff across the remaining
                 1075px. fade_h.png is white with a baked alpha ramp, so
                 colordiffuse tints it to the panel's exact colour and the join
                 is continuous. Neither white.png bands nor fade_edge.png work
                 here: stacked bands leave visible steps at their edges (seams
                 were measured at x=880 and x=975 on a real capture), and
                 fade_edge.png's own pixels are pure black, so tinting can only
                 scale its alpha, never reproduce FF0A0C0E. -->
            <control type="image"><width>845</width><height>1080</height><texture colordiffuse="FF0A0C0E">white.png</texture></control>
            <control type="image"><left>845</left><width>1075</width><height>1080</height><texture colordiffuse="FF0A0C0E">fade_h.png</texture></control>
            <control type="image"><left>120</left><top>96</top><width>64</width><height>64</height><texture>logo.png</texture><aspectratio>keep</aspectratio></control>
            <control type="label"><left>204</left><top>96</top><width>400</width><height>64</height><font>font32</font><textcolor>FFEEF3F6</textcolor><aligny>center</aligny><label>[B]RIVULET[/B]</label></control>
            <control type="image"><left>1080</left><top>104</top><width>720</width><height>48</height><texture colordiffuse="1AFFFFFF">white.png</texture></control>
            <control type="label" id="30005">
                <left>1100</left><top>104</top><width>680</width><height>48</height><font>font10</font><textcolor>A8EEF3F6</textcolor><align>right</align><aligny>center</aligny>
                <label></label>
            </control>
            <control type="list" id="30002">
                <left>120</left><top>248</top><width>900</width><height>600</height>
                <onleft>30002</onleft><onright>30002</onright>
                <itemlayout height="120">
                    <control type="image"><left>34</left><top>34</top><width>52</width><height>52</height><texture colordiffuse="80FFFFFF">$INFO[ListItem.Icon]</texture><aspectratio>keep</aspectratio></control>
                    <control type="label"><left>118</left><top>26</top><width>750</width><height>36</height><font>font32</font><textcolor>C7EEF3F6</textcolor><aligny>center</aligny>
                        <label>$INFO[ListItem.Label]</label>
                    </control>
                    <control type="label"><left>118</left><top>66</top><width>750</width><height>28</height><font>font12</font><textcolor>6BEEF3F6</textcolor><aligny>center</aligny>
                        <label>$INFO[ListItem.Property(subtitle)]</label>
                    </control>
                </itemlayout>
                <focusedlayout height="120">
                    <control type="image"><width>900</width><height>120</height><texture colordiffuse="FF1B2126">white.png</texture></control>
                    <control type="image"><left>0</left><width>6</width><height>120</height><texture colordiffuse="FF38BDF8">white.png</texture></control>
                    <control type="image"><left>34</left><top>34</top><width>52</width><height>52</height><texture>$INFO[ListItem.Icon]</texture><aspectratio>keep</aspectratio></control>
                    <control type="label"><left>118</left><top>26</top><width>750</width><height>36</height><font>font32</font><textcolor>FFFFFFFF</textcolor><aligny>center</aligny>
                        <label>[B]$INFO[ListItem.Label][/B]</label>
                    </control>
                    <control type="label"><left>118</left><top>66</top><width>750</width><height>28</height><font>font12</font><textcolor>B3EEF3F6</textcolor><aligny>center</aligny>
                        <label>$INFO[ListItem.Property(subtitle)]</label>
                    </control>
                </focusedlayout>
            </control>
            <control type="label"><left>120</left><top>968</top><width>600</width><height>32</height><font>Mono26</font><textcolor>57EEF3F6</textcolor><aligny>center</aligny>
                <label>[COLOR FF38BDF8]OK[/COLOR] $ADDON[plugin.video.rivulet 30209]     [COLOR FF38BDF8]BACK[/COLOR] $ADDON[plugin.video.rivulet 30211]</label>
            </control>
        </control>
    </controls>
</window>
