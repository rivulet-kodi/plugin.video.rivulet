<!-- Sources of a title (lib/ui/streamswindow.py), laid out like the series page
     (DetailWindow.xml): the title top left and the clock top right, the section heading with
     its counts, the credit chips, the list under them on the left, the poster and the
     summary on the right. Look tokens: lib/ui/look.py. -->
<window>
    <depth>0.52</depth>
    <coordinates><left>0</left><top>0</top></coordinates>
    <controls>
        <control type="group">
            <left>0</left><top>0</top>
