<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<window>
    <depth>0.52</depth>
    <defaultcontrol>30341</defaultcontrol>
    <coordinates><left>0</left><top>0</top></coordinates>
    <controls>
        <control type="group">
            <left>0</left><top>0</top>
            <animation type="WindowOpen" reversible="false">
                <effect type="fade" delay="0" end="100" time="200" />
            </animation>
            <!-- No WindowClose animation on purpose: Kodi drops every action while the topmost modal plays one (test_skin_xml.py rule 9). -->
            <control type="image"><width>1920</width><height>1080</height><texture colordiffuse="A6000000">white.png</texture></control>

            <control type="image" id="30343"><left>580</left><top>140</top><width>760</width><height>730</height><texture border="32" colordiffuse="E60A0A0A">dlg_panel.png</texture></control>
            <control type="image" id="30344"><left>580</left><top>140</top><width>760</width><height>730</height><texture border="32" colordiffuse="26FFFFFF">dlg_stroke.png</texture></control>

            <control type="label" id="30340">
                <left>628</left><top>178</top><width>664</width><height>44</height>
                <font>font37</font><textcolor>FFFFFFFF</textcolor>
                <label></label>
            </control>

            <control type="image" id="30345"><left>628</left><top>230</top><width>664</width><height>1</height><texture colordiffuse="1AFFFFFF">white.png</texture></control>

            <control type="list" id="30341">
                <left>596</left><top>250</top><width>728</width><height>504</height>
                <onleft>30341</onleft><onright>30341</onright>
                <pagecontrol>30342</pagecontrol>
                <itemlayout height="72">
                    <control type="label"><left>32</left><top>14</top><width>664</width><height>34</height><font>font13</font><textcolor>D9FFFFFF</textcolor>
                        <label>$INFO[ListItem.Label]</label>
                    </control>
                    <control type="label"><left>32</left><top>48</top><width>664</width><height>24</height><font>font12</font><textcolor>B3FFFFFF</textcolor>
                        <label>$INFO[ListItem.Label2]</label>
                        <visible>!String.IsEmpty(ListItem.Label2)</visible>
                    </control>
                </itemlayout>
                <focusedlayout height="72">
                    <control type="image"><left>8</left><width>712</width><height>72</height><texture border="20" colordiffuse="FF2E2E2E">dlg_row.png</texture></control>
                    <control type="label"><left>32</left><top>14</top><width>664</width><height>34</height><font>font13</font><textcolor>FFFFFFFF</textcolor>
                        <label>$INFO[ListItem.Label]</label>
                    </control>
                    <control type="label"><left>32</left><top>48</top><width>664</width><height>24</height><font>font12</font><textcolor>D9FFFFFF</textcolor>
                        <label>$INFO[ListItem.Label2]</label>
                        <visible>!String.IsEmpty(ListItem.Label2)</visible>
                    </control>
                </focusedlayout>
            </control>

            <!-- Kodi's Python API cannot wrap a scrollbar (getControl raises "Unknown control type for python"), so lib/ui/dialogs.py moves this wrapper group instead; the scrollbar sits at its origin. It only shows when the list is a full page (showonepage=false), i.e. at its 504px maximum, so its height never needs to change. -->
            <control type="group" id="30346">
                <left>1300</left><top>250</top>
            <control type="scrollbar" id="30342">
                <left>0</left><top>0</top><width>6</width><height>504</height>
                <texturesliderbar colordiffuse="1FFFFFFF">white.png</texturesliderbar>
                <textureslidernib colordiffuse="FFD6D6D6">white.png</textureslidernib>
                <textureslidernibfocus colordiffuse="FFD6D6D6">white.png</textureslidernibfocus>
                <showonepage>false</showonepage>
                <orientation>vertical</orientation>
            </control>
            </control>
        </control>
    </controls>
</window>
