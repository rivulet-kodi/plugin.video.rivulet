<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!-- Installed addons (lib/ui/addonswindow.py), in the look Home and Search define (tokens in lib/ui/look.py). -->
<window>
    <depth>0.52</depth>
    <coordinates><left>0</left><top>0</top></coordinates>
    <controls>
        <control type="group">
            <left>0</left><top>0</top>
            <visible>!Player.HasVideo</visible>
            <animation type="WindowOpen" reversible="false">
                <effect type="fade" delay="0" end="100" time="200" />
            </animation>
            <!-- No WindowClose animation on purpose: Kodi drops every action while the topmost modal plays one (test_skin_xml.py rule 9). -->
            <control type="image"><left>0</left><top>0</top><width>1920</width><height>1080</height><texture colordiffuse="FF000000">white.png</texture></control>
            <!-- The addon's greyscale artwork, set by the window code (look.fanart()), under a deeper dim than the title pages: this is all rows. -->
            <control type="image" id="30000"><left>0</left><top>0</top><width>1920</width><height>1080</height><texture background="true" colordiffuse="40FFFFFF"></texture><aspectratio align="center" aligny="center">scale</aspectratio></control>
            <control type="image"><left>0</left><top>0</top><width>1920</width><height>1080</height><texture colordiffuse="A6000000">white.png</texture></control>
            <control type="image"><left>0</left><top>0</top><width>1920</width><height>1080</height><texture colordiffuse="FFFFFFFF">look_fade_left.png</texture><aspectratio>stretch</aspectratio></control>
            <control type="image"><left>0</left><top>0</top><width>1920</width><height>220</height><texture colordiffuse="FFFFFFFF">look_fade_top.png</texture><aspectratio>stretch</aspectratio></control>
            <!-- Header, as on Search: the page name in bold, the clock on the right. -->
            <control type="label"><left>80</left><top>36</top><width>900</width><height>50</height><font>font13</font><textcolor>FFEDEDED</textcolor><aligny>center</aligny><label>[B]$ADDON[plugin.video.rivulet 30003][/B]</label></control>
            <control type="label"><left>1040</left><top>36</top><width>800</width><height>50</height><font>font13</font><textcolor>FFEDEDED</textcolor><align>right</align><aligny>center</aligny><label>[B]$INFO[System.Time]$INFO[Weather.Temperature,  •  ,][/B]</label></control>
            <control type="list" id="30002">
                <left>60</left><top>120</top><width>1800</width><height>840</height>
                <onleft>30002</onleft><onright>30002</onright>
                <scrolltime tween="cubic" easing="out">200</scrolltime>
                <pagecontrol>30010</pagecontrol>
                <!-- Seven rows of 120; focused is the white panel with dark text, as on the series page. -->
                <itemlayout height="120">
                    <control type="label"><left>36</left><top>20</top><width>1730</width><height>42</height><font>font13</font><textcolor>E6EDEDED</textcolor><aligny>center</aligny><label>[B]$INFO[ListItem.Label][/B]</label></control>
                    <control type="label"><left>36</left><top>66</top><width>1730</width><height>34</height><font>font12</font><textcolor>B3EDEDED</textcolor><aligny>center</aligny><label>$INFO[ListItem.Label2]</label></control>
                </itemlayout>
                <focusedlayout height="120">
                    <control type="image"><left>0</left><top>6</top><width>1800</width><height>108</height><texture border="40" colordiffuse="FFFFFFFF">look_panel.png</texture><visible>Control.HasFocus(30002)</visible></control>
                    <control type="label"><left>36</left><top>20</top><width>1730</width><height>42</height><font>font13</font><textcolor>FF07090B</textcolor><aligny>center</aligny><label>[B]$INFO[ListItem.Label][/B]</label><visible>Control.HasFocus(30002)</visible></control>
                    <control type="label"><left>36</left><top>66</top><width>1730</width><height>34</height><font>font12</font><textcolor>B307090B</textcolor><aligny>center</aligny><label>$INFO[ListItem.Label2]</label><visible>Control.HasFocus(30002)</visible></control>
                    <control type="label"><left>36</left><top>20</top><width>1730</width><height>42</height><font>font13</font><textcolor>E6EDEDED</textcolor><aligny>center</aligny><label>[B]$INFO[ListItem.Label][/B]</label><visible>!Control.HasFocus(30002)</visible></control>
                    <control type="label"><left>36</left><top>66</top><width>1730</width><height>34</height><font>font12</font><textcolor>B3EDEDED</textcolor><aligny>center</aligny><label>$INFO[ListItem.Label2]</label><visible>!Control.HasFocus(30002)</visible></control>
                </focusedlayout>
            </control>
            <!-- Kept for the page control; the position is printed below. -->
            <control type="scrollbar" id="30010"><left>0</left><top>0</top><width>1</width><height>1</height><onleft>30002</onleft><onright>30002</onright><orientation>vertical</orientation><showonepage>false</showonepage><texturesliderbackground colordiffuse="00FFFFFF">white.png</texturesliderbackground><texturesliderbar colordiffuse="00FFFFFF">white.png</texturesliderbar><texturesliderbarfocus colordiffuse="00FFFFFF">white.png</texturesliderbarfocus><visible>false</visible></control>
            <control type="label"><left>80</left><top>1000</top><width>600</width><height>40</height><font>font12</font><textcolor>B3EDEDED</textcolor><aligny>center</aligny><label>$INFO[Container(30002).CurrentItem] / $INFO[Container(30002).NumItems]</label><visible>Integer.IsGreater(Container(30002).NumItems,0)</visible></control>
            <control type="label"><left>840</left><top>1000</top><width>1000</width><height>40</height><font>font12</font><textcolor>B3EDEDED</textcolor><align>right</align><aligny>center</aligny><label>[B]OK[/B] $ADDON[plugin.video.rivulet 30209]   [B]BACK[/B] $ADDON[plugin.video.rivulet 30210]</label></control>
            <control type="image"><left>80</left><top>1044</top><width>1760</width><height>2</height><texture colordiffuse="24EDEDED">white.png</texture></control>
        </control>
    </controls>
</window>
