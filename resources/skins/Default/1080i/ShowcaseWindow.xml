<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<window>
    <depth>0.52</depth>
    <coordinates><left>0</left><top>0</top></coordinates>
    <controls>
        <control type="group">
            <left>0</left><top>0</top>
            <visible>!Player.HasVideo</visible>
            <animation type="WindowOpen" reversible="false">
                <effect type="slide" start="0,100" end="0,0" delay="160" time="160" />
                <effect type="fade" delay="160" end="100" time="100" />
            </animation>
            <animation type="WindowClose" reversible="false">
                <effect type="slide" start="0,0" end="0,100" delay="160" time="160" />
                <effect type="fade" delay="160" start="100" end="0" time="100" />
            </animation>
            <!-- Fallback wash: covers the instant this window opens, before
                 the background image below has a texture to draw - keeps
                 the opening frame dark instead of flashing skin-default
                 white. -->
            <control type="image"><width>1920</width><height>1080</height><texture colordiffuse="E60A0C0E">white.png</texture></control>
            <!-- Design line 93 is filter:brightness(.55); colordiffuse
                 multiplies, so .55*255 = 0x8C. Was FF777777 (.47). -->
            <control type="image" id="30000"><width>1920</width><height>1080</height><texture colordiffuse="FF8C8C8C"></texture><aspectratio>scale</aspectratio></control>
            <!-- Scrim over the fanart: fade_bottom.png/fade_edge.png bake
                 pure black pixels, and colordiffuse multiplies, so a black
                 source can only ever render black regardless of tint - that
                 produced a full-width seam where the old ramp met a separate
                 FF0A0C0E rect. fade_v.png is white RGB with the design's
                 4-stop alpha ramp (.55/.72/.94/solid at 0/26/52/74% of
                 frame height) baked into it, so one FF0A0C0E-tinted control
                 reproduces the exact gradient continuously, with no seam. -->
            <control type="image"><width>1920</width><height>1080</height><texture colordiffuse="FF0A0C0E">fade_v.png</texture></control>
            <control type="image" id="30001"><top>535</top><left>810</left><width>300</width><height>10</height><texture>white.png</texture>
                <animation effect="zoom" pulse="true" center="auto" start="0,100" end="100,100" time="1000" condition="Control.IsVisible(30001)">Conditional</animation>
            </control>

            <!-- Header: wordmark, breadcrumb, position counter, close. -->
            <control type="image"><left>96</left><top>60</top><width>36</width><height>36</height><texture>logo.png</texture><aspectratio>keep</aspectratio></control>
            <!-- Breadcrumb: ShowcaseWindow.py's onInit() sets this label's
                 text via setLabel() (not an $INFO[] binding - the title is
                 built with inline [COLOR] markup, not a single ListItem/
                 Window property) to "RIVULET" alone, or "RIVULET /
                 <CATALOG>" once open_showcase() is handed a catalog_title -
                 see infowindow.py's `_header_label()`. -->
            <control type="label" id="30100"><left>144</left><top>60</top><width>760</width><height>36</height><font>font10</font><aligny>center</aligny>
                <label>[COLOR 57EEF3F6]RIVULET[/COLOR]</label>
            </control>
            <control type="label"><right>190</right><top>60</top><width>140</width><height>36</height><font>Mono26</font><align>right</align><aligny>center</aligny>
                <label>[COLOR 80EEF3F6]$INFO[Container(30002).CurrentItem][/COLOR][COLOR 47EEF3F6]/$INFO[Container(30002).NumItems][/COLOR]</label>
            </control>
            <control type="button" id="30003">
                <left>1774</left><top>53</top><width>50</width><height>50</height><aligny>center</aligny><align>center</align>
                <texturefocus colordiffuse="FFFFFFFF">close.png</texturefocus>
                <texturenofocus colordiffuse="73FFFFFF">close.png</texturenofocus>
                <ondown>30002</ondown>
            </control>

            <!-- Title. -->
            <control type="label"><left>96</left><top>168</top><width>1180</width><height>76</height><font>font60</font><textcolor>FFFFFFFF</textcolor>
                <label>[B]$INFO[ListItem.Label][/B]</label>
            </control>

            <!-- Metadata line: year, IMDb rating, runtime and genre as
                 one flowing label, composed in Python by infowindow.py's
                 `_meta_line()` (which joins with ' · ' and skips what
                 the meta lacks, so a sparse item never shows a dangling
                 separator).

                 This was three 110px-wide bordered chips, each with its
                 own 1px border rects, plus a reflow matrix that placed
                 every chip and the trailing genre in each slot the ones
                 ahead of it could leave open - ~30 controls in all.
                 Kodi sizes a control from the XML at load time and
                 cannot fit a box to its text, so those fixed widths
                 were wrong in both directions on real data: a series
                 range needs ~140px at Mono26 and rendered clipped
                 ("2010-2017" -> "2010..."), while a "120 min" runtime
                 came within a pixel of both borders. A single label has
                 no width to overflow and no slots to enumerate, and it
                 matches how DetailWindow/StreamsWindow already print
                 the same metadata.

                 font12 (NotoSans), not the chips' Mono26: the line is
                 prose now rather than tabular figures, and the rating
                 reads "IMDb 9.0" - NotoMono has no U+2605 to draw a
                 star with (tests/test_glyph_coverage.py), and the
                 spelled-out name says which scale the number is on,
                 which neither a star nor the old accent-coloured box
                 ever did. -->
            <control type="label"><left>96</left><top>256</top><width>1180</width><height>40</height><font>font12</font><textcolor>C7EEF3F6</textcolor><aligny>center</aligny>
                <label>$INFO[ListItem.Property(meta_line)]</label>
                <visible>!String.IsEmpty(ListItem.Property(meta_line))</visible>
            </control>

            <!-- Plot, at the y=322 the chip layout always put it: the
                 genre is a segment of the metadata line above rather
                 than a line of its own, so nothing moved down. -->
            <control type="textbox"><left>96</left><top>322</top><width>1080</width><height>140</height><font>font27</font><textcolor>B8EEF3F6</textcolor>
                <label>$INFO[ListItem.Property(plot)]</label>
                <autoscroll time="3000" delay="3000" repeat="3000">true</autoscroll>
            </control>

            <control type="fixedlist" id="30002">
                <!-- 1676 = one focused slot (336: 308 ring + 28 gap) + five
                     unfocused (5x268: 240 poster + 28 gap). -->
                <top>592</top><left>96</left><width>1676</width><height>458</height>
                <viewtype>wrap</viewtype><orientation>horizontal</orientation>
                <scrolltime tween="cubic" easing="out">300</scrolltime>
                <!-- focusposition 0: the focused poster leads the strip,
                     flush against the frame's left edge like the rest of
                     this window's content. -->
                <focusposition>0</focusposition>
                <onup>30003</onup>
                <itemlayout width="268" height="458">
                    <control type="image">
                        <top>98</top><left>14</left><width>240</width><height>360</height>
                        <texture colordiffuse="8CFFFFFF">$INFO[ListItem.Property(thumbnail)]</texture>
                        <aspectratio align="center" aligny="center">keep</aspectratio>
                    </control>
                </itemlayout>
                <focusedlayout width="336" height="458">
                    <!-- 4px accent outline as four edges around the
                         300x450 poster, per spec, rather than a backing
                         plate. -->
                    <control type="image"><top>0</top><left>0</left><width>308</width><height>4</height><texture colordiffuse="FF38BDF8">white.png</texture></control>
                    <control type="image"><top>454</top><left>0</left><width>308</width><height>4</height><texture colordiffuse="FF38BDF8">white.png</texture></control>
                    <control type="image"><top>0</top><left>0</left><width>4</width><height>458</height><texture colordiffuse="FF38BDF8">white.png</texture></control>
                    <control type="image"><top>0</top><left>304</left><width>4</width><height>458</height><texture colordiffuse="FF38BDF8">white.png</texture></control>
                    <control type="image">
                        <top>4</top><left>4</left><width>300</width><height>450</height>
                        <texture>$INFO[ListItem.Property(thumbnail)]</texture>
                        <aspectratio align="center" aligny="center">keep</aspectratio>
                    </control>
                </focusedlayout>
            </control>

            <!-- No title under the strip: the hero block above already
                 renders ListItem.Label at font60, so a second copy under
                 the focused poster is the same string twice. It also had
                 nowhere to sit - the strip runs to y=1050 on a 1080-tall
                 frame, so the label's own 1002..1034 band lay on top of
                 the poster rather than under it, colliding with whatever
                 artwork (often the poster's own title treatment) happened
                 to be there. -->

            <control type="image"><left>0</left><top>560</top><width>96</width><height>520</height><texture flipx="true" colordiffuse="FF0A0C0E">fade_out_h.png</texture></control>
            <control type="image"><left>1780</left><top>560</top><width>140</width><height>520</height><texture colordiffuse="FF0A0C0E">fade_out_h.png</texture></control>
        </control>
    </controls>
</window>
