<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!-- Coverflow (lib/ui/infowindow.py), the one screen for a list of titles outside Search:
     a Home catalog's "see all", a genre and a person's titles. Tokens from lib/ui/look.py:
     backdrop with the left/bottom/top fades, the bold page title with the clock, the hero
     stacked above the strip, white ring on the focused poster. -->
<window>
    <depth>0.52</depth>
    <coordinates><left>0</left><top>0</top></coordinates>
    <controls>
        <control type="group">
            <left>0</left><top>0</top>
            <visible>!Window.IsActive(fullscreenvideo)</visible>
            <animation type="WindowOpen" reversible="false">
                <effect type="fade" delay="0" end="100" time="200" />
            </animation>
            <!-- No WindowClose animation on purpose: Kodi drops every action while the topmost modal plays one (test_skin_xml.py rule 9). -->
            <control type="image"><left>0</left><top>0</top><width>1920</width><height>1080</height><texture colordiffuse="FF000000">white.png</texture></control>
            <!-- The backdrop fills the screen; the fades carry the text. -->
            <control type="image" id="30000"><left>0</left><top>0</top><width>1920</width><height>1080</height><texture background="true" colordiffuse="FFFFFFFF"></texture><aspectratio align="center" aligny="center">scale</aspectratio></control>
            <!-- No bar: dark toward the left and the bottom, light at the top. -->
            <control type="image"><left>0</left><top>0</top><width>1920</width><height>1080</height><texture colordiffuse="FFFFFFFF">look_fade_left.png</texture><aspectratio>stretch</aspectratio></control>
            <control type="image"><left>0</left><top>0</top><width>1920</width><height>1080</height><texture colordiffuse="FFFFFFFF">look_fade_bottom.png</texture><aspectratio>stretch</aspectratio></control>
            <control type="image"><left>0</left><top>0</top><width>1920</width><height>220</height><texture colordiffuse="FFFFFFFF">look_fade_top.png</texture><aspectratio>stretch</aspectratio></control>
            <!-- Shown by the window code while the catalog loads. -->
            <control type="image" id="30001"><left>810</left><top>535</top><width>300</width><height>10</height><texture colordiffuse="B3EDEDED">white.png</texture>
                <animation effect="zoom" pulse="true" center="auto" start="0,100" end="100,100" time="1000" condition="Control.IsVisible(30001)">Conditional</animation>
            </control>

            <!-- Header: the page title, set by infowindow.py's `_header_label()` (the catalog's
                 title, or "RIVULET"), placed like Search's and Add-ons'. -->
            <control type="label" id="30100"><left>80</left><top>36</top><width>900</width><height>50</height><font>font13</font><textcolor>FFEDEDED</textcolor><aligny>center</aligny>
                <label>[B]RIVULET[/B]</label>
            </control>
            <control type="label"><left>1040</left><top>36</top><width>800</width><height>50</height><font>font13</font><textcolor>FFEDEDED</textcolor><align>right</align><aligny>center</aligny><label>[B]$INFO[System.Time]$INFO[Weather.Temperature,  •  ,][/B]</label></control>
            <!-- Where the icon row sits on Home: the position, then close. -->
            <control type="label"><left>1380</left><top>100</top><width>380</width><height>56</height><font>font12</font><textcolor>B3EDEDED</textcolor><shadowcolor>C8000000</shadowcolor><align>right</align><aligny>center</aligny>
                <label>$INFO[Container(30002).CurrentItem] / $INFO[Container(30002).NumItems]</label>
            </control>
            <control type="button" id="30003">
                <left>1784</left><top>100</top><width>56</width><height>56</height>
                <texturefocus colordiffuse="FFFFFFFF">look_icon_close_focus.png</texturefocus>
                <texturenofocus colordiffuse="B3FFFFFF">look_icon_close.png</texturenofocus>
                <label></label>
                <ondown>30002</ondown>
            </control>

            <!-- Hero, stacked above the strip like Home's: title, the metadata line
                 (infowindow.py's `_meta_line()`: year, IMDb, runtime and genre as one flowing
                 label, so a sparse item never shows a dangling separator), the plot (three
                 lines, then it scrolls). One flowing label because Kodi parses a width once and
                 cannot fit a box to its text (lib/ui/infowindow.py:141-145). -->
            <control type="label"><left>80</left><top>296</top><width>1100</width><height>80</height><font>font45</font><textcolor>FFEDEDED</textcolor><shadowcolor>C8000000</shadowcolor><aligny>center</aligny><wrapmultiline>false</wrapmultiline>
                <label>$INFO[ListItem.Label]</label>
            </control>
            <control type="label"><left>80</left><top>384</top><width>1200</width><height>40</height><font>font13</font><textcolor>E6EDEDED</textcolor><shadowcolor>C8000000</shadowcolor><aligny>center</aligny>
                <label>$INFO[ListItem.Property(meta_line)]</label>
                <visible>!String.IsEmpty(ListItem.Property(meta_line))</visible>
            </control>
            <control type="textbox"><left>80</left><top>432</top><width>920</width><height>123</height><font>font13</font><textcolor>C7EDEDED</textcolor><shadowcolor>C8000000</shadowcolor>
                <label>$INFO[ListItem.Property(plot)]</label>
                <autoscroll delay="3000" time="4000" repeat="6000">true</autoscroll>
            </control>

            <!-- The strip: one focused slot (336) and unfocused 268s from x=64 to the screen edge,
                 cut there like Home's rows, so the focused poster starts at the same x=80 as
                 the text. Posters are rounded and
                 the focused one has Home's white ring. -->
            <control type="fixedlist" id="30002">
                <top>592</top><left>64</left><width>1856</width><height>458</height>
                <viewtype>wrap</viewtype><orientation>horizontal</orientation>
                <scrolltime tween="cubic" easing="out">300</scrolltime>
                <focusposition>0</focusposition>
                <onup>30003</onup>
                <itemlayout width="268" height="458">
                    <control type="image"><left>16</left><top>88</top><width>240</width><height>360</height><texture colordiffuse="FF16191C">mask_poster.png</texture></control>
                    <control type="image"><left>16</left><top>88</top><width>240</width><height>360</height><texture diffuse="mask_poster.png" background="true">$INFO[ListItem.Property(thumbnail)]</texture><aspectratio align="center" aligny="center">keep</aspectratio><visible>!String.IsEmpty(ListItem.Property(thumbnail))</visible></control>
                    <control type="textbox"><left>28</left><top>88</top><width>216</width><height>360</height><font>font13</font><textcolor>E6EDEDED</textcolor><align>center</align><aligny>center</aligny><label>$INFO[ListItem.Label]</label><visible>String.IsEmpty(ListItem.Property(thumbnail))</visible></control>
                    <!-- Watched check (#85) and IN CINEMA strip (#84), over the poster. -->
                    <control type="image"><left>216</left><top>96</top><width>32</width><height>32</height><texture colordiffuse="B3000000">white.png</texture><visible>String.IsEqual(ListItem.Property(watched),1)</visible></control>
                    <control type="image"><left>221</left><top>101</top><width>22</width><height>22</height><texture colordiffuse="FFEDEDED">look_check.png</texture><visible>String.IsEqual(ListItem.Property(watched),1)</visible></control>
                    <control type="image"><left>24</left><top>412</top><width>224</width><height>30</height><texture colordiffuse="FF38BDF8">white.png</texture><visible>!String.IsEmpty(ListItem.Property(in_cinema))</visible></control>
                    <control type="label"><left>24</left><top>408</top><width>224</width><height>38</height><font>font12</font><textcolor>FF07090B</textcolor><align>center</align><aligny>center</aligny><label>$ADDON[plugin.video.rivulet 30548]</label><visible>!String.IsEmpty(ListItem.Property(in_cinema))</visible></control>
                </itemlayout>
                <focusedlayout width="336" height="458">
                    <control type="image"><left>16</left><top>16</top><width>288</width><height>432</height><texture colordiffuse="FF16191C">mask_poster.png</texture></control>
                    <control type="image"><left>16</left><top>16</top><width>288</width><height>432</height><texture diffuse="mask_poster.png" background="true">$INFO[ListItem.Property(thumbnail)]</texture><aspectratio align="center" aligny="center">keep</aspectratio><visible>!String.IsEmpty(ListItem.Property(thumbnail))</visible></control>
                    <control type="textbox"><left>28</left><top>16</top><width>264</width><height>432</height><font>font13</font><textcolor>E6EDEDED</textcolor><align>center</align><aligny>center</aligny><label>$INFO[ListItem.Label]</label><visible>String.IsEmpty(ListItem.Property(thumbnail))</visible></control>
                    <control type="image"><left>8</left><top>8</top><width>304</width><height>448</height><texture border="24" colordiffuse="FFFFFFFF">look_ring.png</texture><visible>Control.HasFocus(30002)</visible></control>
                    <control type="image"><left>264</left><top>24</top><width>32</width><height>32</height><texture colordiffuse="B3000000">white.png</texture><visible>String.IsEqual(ListItem.Property(watched),1)</visible></control>
                    <control type="image"><left>269</left><top>29</top><width>22</width><height>22</height><texture colordiffuse="FFEDEDED">look_check.png</texture><visible>String.IsEqual(ListItem.Property(watched),1)</visible></control>
                    <control type="image"><left>24</left><top>412</top><width>272</width><height>30</height><texture colordiffuse="FF38BDF8">white.png</texture><visible>!String.IsEmpty(ListItem.Property(in_cinema))</visible></control>
                    <control type="label"><left>24</left><top>408</top><width>272</width><height>38</height><font>font12</font><textcolor>FF07090B</textcolor><align>center</align><aligny>center</aligny><label>$ADDON[plugin.video.rivulet 30548]</label><visible>!String.IsEmpty(ListItem.Property(in_cinema))</visible></control>
                </focusedlayout>
            </control>
        </control>
    </controls>
</window>
