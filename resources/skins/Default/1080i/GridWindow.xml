    <depth>0.52</depth>
    <coordinates><left>0</left><top>0</top></coordinates>
    <controls>
        <control type="group">
            <left>0</left><top>0</top>
            <visible>!Player.HasVideo</visible>
            <animation type="WindowOpen" reversible="false">
                <effect type="fade" delay="0" end="100" time="200" />
            </animation>
            <animation type="WindowClose" reversible="false">
                <effect type="fade" start="100" end="0" time="160" />
            </animation>

            <!-- Fanart of the focused title, dimmed hard so the rows stay
                 legible over it. -->
            <control type="image"><width>1920</width><height>1080</height><texture colordiffuse="FF0A0C0E">white.png</texture></control>
            <control type="image" id="30000"><width>1920</width><height>1080</height><texture colordiffuse="26FFFFFF"></texture><aspectratio>scale</aspectratio></control>
            <control type="image"><width>1920</width><height>1080</height><texture colordiffuse="D90A0C0E">white.png</texture></control>

                        <!-- Set at runtime by GridWindow: "RIVULET / CONTINUE". -->
            <control type="label" id="30006"><right>96</right><top>60</top><width>700</width><height>34</height><align>right</align><font>font10</font><textcolor>4DEEF3F6</textcolor>
                <label></label>
            </control>

            <!-- Focused title + caption: a cell's own label is truncated to
                 its column, so the full title renders here. -->
            <control type="label"><left>96</left><top>58</top><width>1200</width><height>44</height><font>font27</font><textcolor>FFFFFFFF</textcolor>
                <label>$INFO[ListItem.Label]</label>
            </control>
            <control type="label"><left>96</left><top>104</top><width>1200</width><height>26</height><font>font10</font><textcolor>80EEF3F6</textcolor>
                <label>$INFO[ListItem.Property(caption)]</label>
            </control>

            <control type="grouplist" id="30001">
                <left>96</left><top>146</top><width>1760</width><height>900</height>
                <orientation>vertical</orientation>
                <itemgap>10</itemgap>
                <usecontrolcoords>true</usecontrolcoords>
