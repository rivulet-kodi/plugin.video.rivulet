    <depth>0.52</depth>
    <coordinates><left>0</left><top>0</top></coordinates>
    <controls>
        <control type="group">
            <left>0</left><top>0</top>
            <visible>!Player.HasVideo</visible>
            <animation type="WindowOpen" reversible="false">
                <effect type="fade" delay="0" end="100" time="200" />
            </animation>
            <animation type="WindowClose" reversible="false">
                <effect type="fade" start="100" end="0" time="160" />
            </animation>

            <!-- Fanart of the focused title, dimmed hard so the rows stay
                 legible over it. -->
            <control type="image"><width>1920</width><height>1080</height><texture colordiffuse="FF0A0C0E">white.png</texture></control>
            <control type="image" id="30000"><width>1920</width><height>1080</height><texture colordiffuse="26FFFFFF"></texture><aspectratio>scale</aspectratio></control>
            <control type="image"><width>1920</width><height>1080</height><texture colordiffuse="D90A0C0E">white.png</texture></control>
            <!-- Bottom scrim: the cut-off row fades out rather than being
                 chopped, so the crop reads as deliberate. -->
            <control type="image"><left>0</left><top>880</top><width>1920</width><height>200</height><texture colordiffuse="FF0A0C0E">fade_v.png</texture></control>

