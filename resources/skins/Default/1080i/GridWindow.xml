                            <visible>!String.IsEmpty(ListItem.Property(progress_width))</visible>
                        </control>
                        <control type="image"><top>394</top><left>12</left><height>6</height><texture colordiffuse="FF38BDF8">white.png</texture>
                            <width>$INFO[ListItem.Property(progress_width)]</width>
