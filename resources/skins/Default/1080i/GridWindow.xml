                <control type="panel" id="30002">
                    <left>0</left><top>0</top><width>1800</width><height>470</height>
                    <orientation>horizontal</orientation>
                    <onleft>30002</onleft><onright>30002</onright>
                    <scrolltime tween="cubic" easing="out">260</scrolltime>
                    <visible>Integer.IsGreater(Container(30002).NumItems,0)</visible>
                    <itemlayout width="280" height="470">
                        <control type="image">
                            <top>0</top><left>12</left><width>256</width><height>384</height>
                            <texture colordiffuse="B3FFFFFF" background="true">$INFO[ListItem.Property(thumbnail)]</texture>
                            <aspectratio align="center" aligny="center">keep</aspectratio>
                            <visible>String.IsEmpty(ListItem.Property(watched))</visible>
                        </control>
                        <!-- A finished title is dimmed so the eye skips past it. -->
                        <control type="image">
                            <top>0</top><left>12</left><width>256</width><height>384</height>
                            <texture colordiffuse="4DFFFFFF" background="true">$INFO[ListItem.Property(thumbnail)]</texture>
                            <aspectratio align="center" aligny="center">keep</aspectratio>
                            <visible>!String.IsEmpty(ListItem.Property(watched))</visible>
