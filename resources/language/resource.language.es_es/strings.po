msgstr "Guardado. Puedes cerrar esta página."

msgctxt "#30465"
msgid "That code does not match."
msgstr "Ese código no coincide."

msgctxt "#30466"
msgid "Enter a key."
msgstr "Introduce una clave."

msgctxt "#30467"
msgid "Already saved."
msgstr "Ya está guardado."

msgctxt "#30468"
msgid "That key is too long."
msgstr "Esa clave es demasiado larga."

msgctxt "#30469"
msgid "Could not save the key."
msgstr "No se pudo guardar la clave."

msgctxt "#30474"
msgid "Install from your phone"
msgstr "Instalar desde el teléfono"

msgctxt "#30475"
msgid "Type the address"
msgstr "Escribir la dirección"

msgctxt "#30476"
msgid "Open this page on your phone and paste the addon's install link. It works for 3 minutes."
msgstr "Abre esta página en el teléfono y pega el enlace de instalación del complemento. Funciona durante 3 minutos."

msgctxt "#30477"
msgid "Configure this addon"
msgstr "Configurar este complemento"

msgctxt "#30478"
msgid "Paste a link that starts with https://."
msgstr "Pega un enlace que empiece por https://."

msgctxt "#30479"
msgid "That link is too long."
msgstr "Ese enlace es demasiado largo."

msgctxt "#30480"
msgid "Sign in with your phone"
msgstr "Entrar con el teléfono"

msgctxt "#30481"
msgid "Type email and password"
msgstr "Escribir correo y contraseña"

msgctxt "#30482"
msgid "Scan the QR or open the address on your phone and sign in to Stremio there."
msgstr "Escanea el QR o abre la dirección en el teléfono e inicia sesión en Stremio allí."

msgctxt "#30485"
msgid "Open this page on your phone and type what to search for. It works for 3 minutes."
msgstr "Abre esta página en el teléfono y escribe lo que quieres buscar. Funciona durante 3 minutos."

msgctxt "#30486"
msgid "Type something to search for."
msgstr "Escribe algo para buscar."

msgctxt "#30487"
msgid "That search is too long."
msgstr "Esa búsqueda es demasiado larga."

msgctxt "#30488"
msgid "Signed in"
msgstr "Sesión iniciada"

msgctxt "#30494"
msgid "Ends at %s"
msgstr "Termina a las %s"

msgctxt "#30495"
msgid "Home"
msgstr "Inicio"

msgctxt "#30497"
msgid "No trailer for this title."
msgstr "Este título no tiene tráiler."

msgctxt "#30498"
msgid "Can't play the trailer. Start the streaming server or install Kodi's YouTube add-on."
msgstr "No se puede reproducir el tráiler. Inicia el servidor de streaming o instala el complemento de YouTube de Kodi."

msgctxt "#30499"
msgid "Trailer"
msgstr "Tráiler"

msgctxt "#30501"
msgid "Cached data cleared. Home reloads when you leave Settings."
msgstr "Datos en caché borrados. Inicio se recarga al salir de Ajustes."

msgctxt "#30502"
msgid "Refresh cached data"
msgstr "Actualizar datos en caché"

msgctxt "#30503"
msgid "Forgets saved catalog pages, title details, ratings and logo checks, so the next screens ask your addons again. Your account, addons and progress stay."
msgstr "Olvida las páginas de catálogo, los detalles, las valoraciones y las comprobaciones de logotipos guardados, para que las siguientes pantallas vuelvan a preguntar a tus complementos. Tu cuenta, complementos y progreso se mantienen."

msgctxt "#30504"
msgid "Trailers play through Kodi's YouTube add-on. Install it now?"
msgstr "Los tráileres se reproducen con el complemento de YouTube de Kodi. ¿Instalarlo ahora?"

msgctxt "#30510"
msgid "The trailer would not start. Try playing any video in Kodi's YouTube add-on to check it."
msgstr "El tráiler no se inició. Reproduce cualquier vídeo en el complemento de YouTube de Kodi para comprobarlo."

msgctxt "#30514"
msgid "Go to series"
msgstr "Ir a la serie"

msgctxt "#30515"
msgid "Want Rotten Tomatoes and Metacritic scores? Get a free key at omdbapi.com/apikey.aspx and enter it here."
msgstr "¿Quieres las puntuaciones de Rotten Tomatoes y Metacritic? Consigue una clave gratuita en omdbapi.com/apikey.aspx e introdúcela aquí."

msgctxt "#30516"
msgid "My Stuff"
msgstr "Mis contenidos"

msgctxt "#30517"
msgid "Remove from Continue"
msgstr "Quitar de Continuar"

msgctxt "#30518"
msgid "Arrange Home lists"
msgstr "Organizar listas de Inicio"

msgctxt "#30519"
msgid "Choose which lists each tab shows, and in what order."
msgstr "Elige qué listas muestra cada pestaña y en qué orden."

msgctxt "#30520"
