msgstr "Listas: %d"

msgctxt "#30521"
msgid "Reset to default"
msgstr "Restablecer valores predeterminados"

msgctxt "#30522"
msgid "Add a list"
msgstr "Añadir una lista"

msgctxt "#30523"
msgid "Move up"
msgstr "Subir"

msgctxt "#30524"
msgid "Move down"
msgstr "Bajar"

