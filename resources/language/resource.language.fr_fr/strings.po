msgstr "Saisir l'adresse"

msgctxt "#30476"
msgid "Open this page on your phone and paste the addon's install link. It works for 3 minutes."
msgstr "Ouvre cette page sur le téléphone et colle le lien d'installation de l'extension. Elle fonctionne 3 minutes."

msgctxt "#30477"
